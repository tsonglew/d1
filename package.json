{
  "name": "desktop-pet",
  "version": "0.1.0",
  "description": "Desktop pet using Electron, TypeScript, and Live2D.",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"tsc -p tsconfig.main.json --watch\" \"tsc -p tsconfig.preload.json --watch\" \"vite\" \"wait-on http://localhost:5173 dist/main/main.js dist/preload/preload.js && electron .\"",
    "start": "electron .",
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && vite build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "electron": "^31.0.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.example.desktoppet",
    "productName": "DesktopPet",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "mac": {
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
